# ─── Core ───────────────────────────────────────────────────────────────
PORT=4100
# SQLite file. In demo mode the database is re-seeded automatically when empty.
DATABASE_PATH=./data/demo.db
# Which tenant (hauler) the dashboard opens as.
DEFAULT_TENANT=kestrel-ridge
# Public URL of the deployed app. Used for preference links in messages and
# provider status webhooks. Leave blank locally.
PUBLIC_BASE_URL=

# Protect the hosted dashboard. When set, the dashboard requires this password.
# Strongly recommended for any public deployment.
DEMO_PASSWORD=
# Optional: secret used to sign session cookies (defaults to one derived from DEMO_PASSWORD).
SESSION_SECRET=

# ─── Delivery mode ──────────────────────────────────────────────────────
# "simulated" (default) never contacts a real provider.
SMS_PROVIDER=simulated        # simulated | twilio
EMAIL_PROVIDER=simulated      # simulated | resend

# Live safety net. Even with a live provider selected, ONLY these recipients
# get real messages; everyone else (all fictional customers) is simulated.
# Comma-separated phone numbers and/or emails.
LIVE_ALLOWLIST=
# Set to true only in production with real, consented customers.
LIVE_ALLOW_ALL=false

# Undo window: seconds a manual send waits (with Cancel / Send now) before it
# goes out. Scheduled automations are not held. 0 disables the window.
SEND_HOLD_SECONDS=60

# Milliseconds before a simulated message flips from "sent" to "delivered".
SIMULATED_DELIVERY_DELAY_MS=1200
# Used for the cost estimate shown in the template editor (USD per SMS segment).
SMS_COST_PER_SEGMENT=0.011

# ─── Twilio (SMS) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a sending number (E.164, e.g. +19705550123) or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ─── Resend (email) ─────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
# Signing secret from the Resend webhook settings (starts with whsec_).
RESEND_WEBHOOK_SECRET=

# ─── Automation ─────────────────────────────────────────────────────────
# Runs enabled automations (next-day pickup reminders, billing reminders)
# at their scheduled local times.
SCHEDULER_ENABLED=true
